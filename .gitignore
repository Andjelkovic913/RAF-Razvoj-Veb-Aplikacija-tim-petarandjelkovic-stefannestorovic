# ============================================================
# RAF Novosti - monorepo .gitignore
# Backend (backend/) i Frontend (frontend/) idu u git.
# Sve ostalo (demo, dokumentacija, build artefakti) - NE.
# ============================================================

# ---------- Demo reference (samo lokalno) ----------
demo/
demo2/
react-demo/

# ---------- Projektna dokumentacija (lokalno za tim) ----------
*.md
specifikacija.md
CLAUDE.md
TODO.md

# ---------- IDE ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log

# ---------- Build output ----------
**/target/
**/out/
**/build/
**/dist/

# ---------- Node (frontend) ----------
node_modules/
.env
.env.local
.env.*.local
.parcel-cache/

# ---------- Vite ----------
frontend/dist/
frontend/.vite/

# ---------- Maven wrapper extras ----------
.mvn/wrapper/maven-wrapper.jar.bak
